// Cloudflare Workers config for navibeat.app (static assets worker).
// Committed so Workers Builds stops auto-generating this on every build
// (the auto-setup also mis-answers the "functions directory" prompt).
//
// 2026-07-22: added a real Worker entry (src/worker.js) because the repo's
// functions/ directory is the Cloudflare PAGES convention and never runs on
// Workers, so /api/reviews returned 404 and the reviews section silently fell
// back to the committed reviews.json snapshot. Assets are still served first;
// the script only runs for paths that match no file.
{
  "name": "navibeat-site",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "REVIEWS_KV",
      "id": "dcfb8acaaa5f4b67990bc1531d175c8e"
    },
    {
      // 2026-07-26: download counters for the Linux release binaries. GitHub
      // only reports a cumulative count, so the per-day series is snapshotted
      // by the cron below and stored here under key `linux-downloads`.
      "binding": "NAVIBEAT_STATS",
      "id": "d28f2561df244f0c824f45483277aa1a"
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Snapshot the GitHub download counters four times a day (UTC). One a day
  // would give the same daily granularity; four means one failed poll does not
  // leave a hole in the series.
  "triggers": {
    "crons": ["11 */6 * * *"]
  }
}
